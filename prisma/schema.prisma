// Prisma schema for the personal HQ dashboard.
// Each phase of the build adds more models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Phase 1: auth -----------------------------------------------------

enum Role {
  OWNER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(OWNER)
  // Module keys this user can see, e.g. ["content","analytics","people",
  // "mail","comms","automations"]. Ignored for OWNER, who always sees
  // everything — this only restricts EMPLOYEE accounts.
  permissions  String[] @default([])
  invitedById  String?
  invitedBy    User?    @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]   @relation("Invites")
  createdAt    DateTime @default(now())

  // Per-person email signature, appended server-side to every email this
  // user sends through the app — automated sequences/automations and
  // manual Mail compose/reply alike, since both funnel through
  // sendGmail/sendGmailReply in lib/integrations/gmail.ts. Structured
  // fields (not raw HTML) so the rendered card stays consistent and this
  // never has to trust user-authored markup. See lib/email-signature.ts.
  signatureEnabled   Boolean @default(false)
  signatureName      String?
  signatureTitle     String?
  signatureCompany   String?
  signatureAddress   String?
  signaturePhone     String?
  signatureEmail     String?
  signatureWebsite   String?
  signatureInstagram String?
  signatureFacebook  String?
  signatureLogoUrl   String?
  signatureAccent    String?

  reels                   Reel[]
  stats                   WeeklyStat[]
  contactsCreated         Contact[]            @relation("CreatedBy")
  interactions            Interaction[]
  automations             Automation[]
  emailTemplates          EmailTemplate[]
  emailSequences          EmailSequence[]
  gmailConnection         GmailConnection?
  trainingCheckIns        TrainingCheckIn[]
  shootCards              ShootCard[]
  labEntries              StudioEntry[]
  brainEntries            BrainEntry[]
  calendarEvents          CalendarEvent[]
  availabilities          Availability[]
  docs                    DocRecord[]
  recordings              Recording[]
  meetingNotes            MeetingNote[]
  igAutomations           IGAutomation[]
  adCampaigns             AdCampaign[]
  cfoTransactions         CFOTransaction[]
  cfoBudgetCategories     CFOBudgetCategory[]
  cfoMerchantRules        CFOMerchantRule[]
  cfoRecurringBills       CFORecurringBill[]
  cfoGoals                CFOGoal[]
  cfoDebts                CFODebt[]
  cfoBudgetOverrides      CFOBudgetOverride[]
  emailCampaigns          EmailCampaign[]
  smsCampaigns            SmsCampaign[]
  protocolListMembers     ProtocolListMember[]
  uploadedImages          UploadedImage[]
  callRecordings          CallRecording[]
  confirmedSequenceDrafts SequenceStepDraft[]
  marketingEvents         MarketingEvent[]
  activationsCreated      Activation[]
  sopDocumentsCreated     SopDocument[]
  contentIdeasCreated     ContentIdea[]
  contentScriptsCreated   ContentScript[]
  contentPostsCreated     ContentPost[]
  contentCarouselsCreated ContentCarousel[]
  salesScriptsUpdated     SalesScript[]
}

// --- Phase 2: content & analytics ---------------------------------------

model Reel {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String
  title           String
  url             String?
  views           Int      @default(0)
  followersGained Int      @default(0)
  postedAt        DateTime
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId, postedAt])
}

model WeeklyStat {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String
  weekOf        DateTime
  followerCount Int
  createdAt     DateTime @default(now())

  @@unique([userId, platform, weekOf])
}

// --- Phase 3/4: CRM + comms ----------------------------------------------

// One CRM: every company/person you're in touch with — regular
// fence-and-asphalt clients as well as Protocol sponsor/venue leads —
// lives in this single table, distinguished by `type`. This used to be
// two separate models (Contact + ProtocolLead) with two separate nav
// sections; merged into one so there's a single CRM ("Protocol CRM")
// with one email history, one AI summary, one follow-up sequence system
// for every kind of lead.
enum ContactType {
  CLIENT
  SPONSOR
  VENUE
}

enum ContactLanguage {
  EN
  FR
}

// Pipeline stages, in board-column order (see the Kanban board view).
enum LeadStatus {
  NEW_LEAD
  CONTACTED_ONCE
  FOLLOW_UP_1
  FOLLOW_UP_2
  FOLLOW_UP_LAST
  STALE
  MEETING_BOOKED
  NEGOTIATING
  WON
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

model Contact {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // display id, e.g. "L001"

  companyName String?
  contactName String
  title       String? // e.g. "CEO"
  email       String?
  phone       String?
  website     String?
  industry    String?
  // Which language to draft/send this contact's sequence emails in — see
  // EmailSequenceStep.subjectFr/bodyFr and sequence-research.ts. Manually
  // set (there's no reliable way to auto-detect it); defaults to English.
  language    ContactLanguage @default(EN)

  type     ContactType   @default(CLIENT)
  status   LeadStatus    @default(NEW_LEAD)
  priority LeadPriority?
  tags     String[]      @default([])

  source      String?
  assignedRep String? // freeform — not everyone touching this has an app login

  dateFirstContacted DateTime?
  lastContactDate    DateTime?
  totalTouches       Int       @default(0)
  eventOpportunity   String?
  dealValue          Float?
  followUpOwner      String?
  notes              String?

  createdById String?
  createdBy   User?    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // AI-generated read of the email conversation so far — see
  // /api/contacts/[id]/summarize. Regenerated on demand, not live; if the
  // lead has replied since summaryGeneratedAt, the panel says so. nextStep
  // doubles as a manually-editable field (from the old Protocol CRM table)
  // and the AI's suggested next step — either can set it.
  lastConversationSummary String?
  nextStep                String?
  nextFollowUpDate        DateTime?
  summaryGeneratedAt      DateTime?

  interactions        Interaction[]
  people              ContactPerson[]
  sequenceEnrollments SequenceEnrollment[]
  activation          Activation?
  shootCards          ShootCard[]
  labEntries          StudioEntry[]
  calendarEvents      CalendarEvent[]
  docs                DocRecord[]
  recordings          Recording[]
  meetingNotes        MeetingNote[]
  adCampaigns         AdCampaign[]
  emailSends          EmailSend[]
  smsSends            SmsSend[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([type])
  @@index([nextFollowUpDate])
}

// Additional stakeholders on a lead beyond its one primary contact —
// e.g. a venue's events manager AND their finance contact, or a
// sponsor's main rep plus an assistant CC'd on everything. Each
// person's email/phone is matched against incoming and outgoing mail
// too (see findContactSummariesByEmails / mapEmailsToContactIds in
// crm-contact.ts), so a message to or from any of them still lands on
// this lead's timeline, not just the primary Contact.email.
model ContactPerson {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([email])
}

enum InteractionType {
  EMAIL
  CALL
  TEXT
  NOTE
  VIDEO_CALL
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

// Outcome of a logged CALL, for the Sales dashboard's call-tracking
// metrics (calls made, connect rate, voicemails, demos booked, etc.) —
// see lib/sales-metrics.ts.
enum CallOutcome {
  NO_ANSWER // dialed, nobody picked up, no voicemail left
  VOICEMAIL // left a voicemail
  CONNECTED_NOT_BOOKED // reached a person, no demo/next step booked
  DEMO_BOOKED // reached a person, booked a video/demo call
  RESCHEDULED // a previously booked demo was moved
}

model Interaction {
  id              String               @id @default(cuid())
  contactId       String
  contact         Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId          String? // rep who sent/handled it, null for pure inbound auto-logged
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            InteractionType
  direction       InteractionDirection
  subject         String?
  body            String?
  fromAddress     String?
  toAddress       String?
  phoneNumber     String?
  durationSeconds Int?
  recordingUrl    String?
  // Call-tracking outcome for the Sales dashboard (/dashboard/sales) — set
  // either when manually logging a call, or tagged afterward on a
  // Twilio-bridged or live-recorded call whose outcome wasn't known until
  // after it happened. Only meaningful for type CALL; left null for every
  // other interaction type.
  callOutcome     CallOutcome?
  externalId      String? // Gmail message id / Twilio call or message sid, for de-duping syncs
  occurredAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())

  // Speaker-diarized transcript of a recorded phone call (see
  // integrations/assemblyai.ts + lib/call-transcription.ts). Only ever set
  // for CALL interactions that went through Twilio's recorded-call flow —
  // null/not-set for everything else (manual logs, video calls with a
  // pasted link, etc.), so this never shows a "transcribing..." state for
  // interactions that were never going to have one.
  transcript       String?
  transcriptStatus TranscriptStatus?
  transcriptError  String?

  // Persisted Sales Coach analysis — generated once per call (on demand,
  // not automatically, since it's a real Claude call per call) and cached
  // here so it survives the page reload the old chat-only version didn't.
  // coachingStrengthTags/coachingIssueTags are picked from a fixed
  // vocabulary (see lib/sales-coach-tags.ts) specifically so they can be
  // counted/aggregated across every call into a recurring-pattern view,
  // instead of a free-text tag that'd never match itself twice.
  coachingNotes        String?
  coachingStrengthTags String[]  @default([])
  coachingIssueTags    String[]  @default([])
  coachingGeneratedAt  DateTime?

  // Set only when this Interaction IS a sequence step's send (see
  // runDueSequenceSteps in sequences.ts and sendConfirmedDraft in
  // sequence-drafts.ts) — lets the lead page show exactly when each step
  // of a sequence actually went out, rather than guessing from
  // lastSentAt/currentStep alone.
  sequenceEnrollmentId String?
  sequenceEnrollment   SequenceEnrollment? @relation(fields: [sequenceEnrollmentId], references: [id], onDelete: SetNull)
  sequenceStepOrder    Int?

  @@index([contactId, occurredAt])
  @@index([externalId])
  @@index([sequenceEnrollmentId])
}

// --- Automations ----------------------------------------------------------

enum AutomationTrigger {
  NEW_CONTACT
  TAG_ADDED
  NO_REPLY_DAYS
  MANUAL
}

enum AutomationAction {
  SEND_EMAIL
  ADD_TAG
  LOG_NOTE
}

model Automation {
  id            String            @id @default(cuid())
  name          String
  triggerType   AutomationTrigger
  triggerConfig Json              @default("{}")
  actionType    AutomationAction
  actionConfig  Json              @default("{}")
  enabled       Boolean           @default(true)
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastRunAt     DateTime?
  createdAt     DateTime          @default(now())
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// --- Lead nurture: multi-step automated follow-up sequences ------------
//
// A sequence is an ordered list of emails ("touch 1", "touch 2", ...),
// each with a delay in days from the one before it (or from enrollment,
// for the first step). A contact is enrolled by hand from their page —
// nothing auto-enrolls a lead. The 15-minute tick in instrumentation.ts
// (same loop that already runs Automations) sends whatever step is due,
// logs it as a normal outbound Interaction, and advances the enrollment.
// If the lead replies (an inbound Interaction gets synced for them — see
// /api/mail/inbox), the enrollment is auto-paused (REPLIED) so a real
// reply never gets buried under a canned follow-up.
enum SequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  COMPLETED
  CANCELED
  // A step's draft has been generated (subject/body, with any AI-researched
  // personalization) and is sitting in Automation Confirmations waiting for
  // a human to review and confirm — see SequenceStepDraft below. Never
  // picked up by the ACTIVE-only send tick, so nothing goes out on its own.
  AWAITING_CONFIRMATION
}

model EmailSequence {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  enabled              Boolean  @default(true)
  // When true, no step of this sequence ever sends automatically — each
  // due step instead generates a SequenceStepDraft for manual review in
  // Automation Confirmations. Meant for cold outreach that leans on a
  // personalized, researched observation the rep needs to eyeball for
  // accuracy before it goes out; a plain templated sequence can leave
  // this off and keep sending straight through like before.
  requiresConfirmation Boolean  @default(false)
  createdById          String?
  createdBy            User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())

  steps       EmailSequenceStep[]
  enrollments SequenceEnrollment[]
}

model EmailSequenceStep {
  id            String        @id @default(cuid())
  sequenceId    String
  sequence      EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order         Int // 0-based position within the sequence
  // What to research and drop into this step's {{observation}} /
  // {{hook}} tokens (see src/lib/sequence-research.ts) — e.g. "a specific,
  // personalized hook: why Protocol and this brand's audience overlap
  // right now." Null/blank means this step needs no personalization
  // research at all (a plain merge-field send, or the sequence doesn't
  // require confirmation in the first place).
  researchAngle String?
  delayDays     Int // days after the previous step (or after enrollment, for step 0)
  subject       String
  body          String // supports {{contactName}}, {{firstName}}, {{companyName}}, {{brand}}, {{repName}}, {{observation}}, {{hook}}, {{bookingLink}} merge fields
  // French versions of subject/body, used instead of the fields above
  // whenever the enrolled contact's `language` is FR (see Contact.language
  // and src/lib/sequences.ts / sequence-drafts.ts). Null means this step
  // has no French version yet — the English subject/body is sent instead.
  // researchAngle stays a single English instruction either way; only the
  // requested OUTPUT language changes (see sequence-research.ts).
  subjectFr     String?
  bodyFr        String?

  @@index([sequenceId, order])
}

model SequenceEnrollment {
  id          String                   @id @default(cuid())
  contactId   String
  contact     Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    EmailSequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  status      SequenceEnrollmentStatus @default(ACTIVE)
  currentStep Int                      @default(0) // index of the NEXT step to send
  nextSendAt  DateTime?
  lastSentAt  DateTime?
  enrolledAt  DateTime                 @default(now())

  drafts       SequenceStepDraft[]
  interactions Interaction[] // one per step actually sent — see Interaction.sequenceStepOrder

  @@index([status, nextSendAt])
  @@index([contactId])
}

enum SequenceDraftStatus {
  PENDING
  SENT
  REJECTED
}

// A drafted step for a sequence whose `requiresConfirmation` is on — the
// tick generates one of these (with any AI-researched personalization
// already merged into subject/body) instead of sending straight away, and
// it sits on the Automation Confirmations page until a person reviews the
// research for accuracy, edits it if needed, and either confirms (sends
// it and advances the enrollment) or rejects it (skips this step, or
// cancels the enrollment outright).
model SequenceStepDraft {
  id            String              @id @default(cuid())
  enrollmentId  String
  enrollment    SequenceEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepOrder     Int
  subject       String
  body          String
  // Human-readable note on how the personalization was produced — live
  // web-search findings and sources, or a note that research wasn't
  // available and the rep should fill it in by hand. Shown next to the
  // draft so the confirmation isn't just "trust me."
  researchNotes String?
  status        SequenceDraftStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?               @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  sentAt        DateTime?
  error         String?

  @@unique([enrollmentId, stepOrder])
  @@index([status])
}

// --- Integrations -----------------------------------------------------

// One Gmail connection per rep, so "who's in contact with the client"
// can send/reply as themselves.
model GmailConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String // encrypted at rest, see src/lib/crypto.ts
  refreshToken String // encrypted at rest
  expiresAt    DateTime
  connectedAt  DateTime @default(now())

  // Progress for the one-time full-mailbox history backfill (see
  // src/lib/gmail-history-sync.ts) — a Gmail list pageToken to resume
  // from, so a mailbox with thousands of messages can be processed in
  // repeated bounded chunks (one HTTP request each) instead of one huge
  // request that would time out.
  // "ALL" | "DONE" — walks the whole mailbox (minus Spam/Trash) in one
  // pass rather than by label, since an archived message keeps existing
  // but loses the INBOX/SENT label a label-restricted walk would need.
  historySyncPhase     String    @default("ALL")
  historySyncCursor    String?
  historySyncDone      Boolean   @default(false)
  historySyncProcessed Int       @default(0)
  historySyncMatched   Int       @default(0)
  historySyncStartedAt DateTime?
}

// Single shared business line — everyone texts/calls from the same number.
model TwilioConnection {
  id          String   @id @default(cuid())
  accountSid  String
  authToken   String // encrypted at rest
  phoneNumber String
  connectedAt DateTime @default(now())
}

// --- Training -------------------------------------------------------------

// The weekly schedule, session library, and principles live as static data
// in src/lib/training-data.ts. This model is just the per-user adherence
// tracker: did you actually do Monday's session this week. Personal to
// whoever checks it off — not shared across the team.
model TrainingCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String // "mon" .. "sun", matches training-data.ts
  weekOf    DateTime // normalized to that week's Monday, 00:00
  done      Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, dayKey, weekOf])
}

// --- Shoot Board (per-client content production Kanban) -------------------

enum ShootStage {
  SCRIPTING
  FILM
  EDITING
  READY
  POSTED
}

model ShootCard {
  id          String     @id @default(cuid())
  contactId   String? // the client this piece of content is for
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientLabel String? // freeform fallback when there's no CRM contact yet, e.g. "Sauna manufacturer"
  title       String
  notes       String?
  stage       ShootStage @default(SCRIPTING)
  order       Int        @default(0) // position within its column
  dueDate     DateTime?
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([stage, order])
  @@index([contactId])
}

// --- Content Lab (ad / script / trend breakdowns) --------------------------
// v1 is manual capture: paste a transcript or describe a trend you spotted
// and log the breakdown. Live Meta Ads pulls and AI-generated analysis are
// the natural next step once ad-account credentials are connected.

enum StudioEntryKind {
  AD
  SCRIPT
  TREND
}

model StudioEntry {
  id          String          @id @default(cuid())
  kind        StudioEntryKind
  title       String
  clientId    String?
  client      Contact?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  platform    String?
  sourceUrl   String?
  content     String? // the raw script / transcript / trend description
  breakdown   String? // what's working / why it matters / how to use it with clients
  tags        String[]        @default([])
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([kind, createdAt])
}

// --- Brain (personal knowledge system: learnings / thoughts / notes) ------

enum BrainType {
  LEARNING
  THOUGHT
  NOTE
}

enum BrainCategory {
  PERSONAL
  BUSINESS
  MARKETING
  EVENTS
  FITNESS
  PHILOSOPHY
  CREATIVITY
  RELATIONSHIPS
  OTHER
}

model BrainEntry {
  id          String        @id @default(cuid())
  type        BrainType
  category    BrainCategory @default(OTHER)
  source      String? // book / podcast / person it came from, blank for own thoughts
  content     String
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([type, category, createdAt])
}

// --- Calendar ---------------------------------------------------------

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  location    String?
  notes       String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

// --- Booking ------------------------------------------------------------
// v1: you set weekly availability windows, share the public /book link,
// people request a slot, you confirm or decline from the dashboard. No
// external calendar sync yet — that's the natural next step.

model Availability {
  id          String   @id @default(cuid())
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startTime   String // "09:00"
  endTime     String // "17:00"
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([dayOfWeek])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model BookingRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String?
  requestedAt DateTime // the slot they asked for
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([status, requestedAt])
}

// --- Docs + Sign ----------------------------------------------------------
// A document's lifecycle: draft -> sent -> signed. Signing is a typed
// legal-name capture on a public link, not a certified e-signature product
// — good enough for internal agreements, not a DocuSign replacement.

enum DocStatus {
  DRAFT
  SENT
  SIGNED
}

model DocRecord {
  id          String    @id @default(cuid())
  title       String
  content     String // plain text / markdown body
  status      DocStatus @default(DRAFT)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  signerName  String?
  signerEmail String?
  signedAt    DateTime?
  sentAt      DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

// --- Recordings -----------------------------------------------------------
// A library of recordings — Loom-style screen shares, uploaded videos, or
// links to Twilio call recordings already captured through Comms.

enum RecordingKind {
  SCREEN
  CALL
  VIDEO
}

model Recording {
  id          String        @id @default(cuid())
  title       String
  url         String
  kind        RecordingKind @default(SCREEN)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

// --- Copilot (meeting / call notes) ----------------------------------------
// Paste a transcript, capture the summary/decisions/action items. Live
// auto-transcription is the natural next step once a speech-to-text key is
// connected — this is the structured-notes half of that working today.

model MeetingNote {
  id          String   @id @default(cuid())
  title       String
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  transcript  String?
  summary     String?
  decisions   String?
  actionItems String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// --- IG Automations ---------------------------------------------------
// Config lives here and the rules are visible/editable now; actually
// firing them against Instagram needs a connected Meta/Instagram Graph
// API app (its own approval process) — wire that in once you have it.

enum IGTrigger {
  COMMENT_KEYWORD
  DM_KEYWORD
  NEW_FOLLOWER
}

model IGAutomation {
  id          String    @id @default(cuid())
  name        String
  trigger     IGTrigger
  keyword     String?
  replyText   String?
  enabled     Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

// --- Ads (manual tracker) --------------------------------------------------
// v1 is a manual ledger of what's running per client/platform. A live Meta
// Ads pull (spend, results synced automatically) is the natural next step
// once an ad account and API keys are connected.

enum AdStatus {
  ACTIVE
  PAUSED
  ENDED
}

model AdCampaign {
  id          String    @id @default(cuid())
  name        String
  platform    String    @default("meta")
  clientId    String?
  client      Contact?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  budget      Float?
  spend       Float?
  results     String?
  status      AdStatus  @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

// --- CFO (personal budget, cashflow, goals) --------------------------------
// Entirely personal to whoever's using it — every model is scoped by userId,
// unlike the CRM data above, since this is one person's bank activity, not
// shared team data. No live bank connection: Wealthsimple (like most
// Canadian banks) has no public API, so this works off pasting your activity
// feed text in — see src/lib/cfo-parser.ts for how that's turned into rows.

enum CFOTxnType {
  INCOME
  EXPENSE
}

model CFOTransaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  amount      Float // always positive; type carries the sign
  type        CFOTxnType
  category    String // matches a CFOBudgetCategory.key, or "uncategorized"
  pending     Boolean    @default(false)
  rawText     String? // original pasted line, kept for re-review if parsing was off
  createdAt   DateTime   @default(now())

  activationPayment ActivationPayment?

  @@index([userId, date])
  @@index([userId, category])
}

model CFOBudgetCategory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String
  label         String
  monthlyBudget Float    @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, key])
}

// Merchant text → category, learned as you correct parsed transactions, so
// next week's paste categorizes itself.
model CFOMerchantRule {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchText String // lowercase substring matched against the transaction description
  category  String
  type      CFOTxnType @default(EXPENSE)
  createdAt DateTime   @default(now())

  @@unique([userId, matchText])
}

model CFORecurringBill {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  amount     Float
  dayOfMonth Int // 1-31, billed against the closest valid day for shorter months
  category   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId, dayOfMonth])
}

model CFOGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Float
  savedSoFar   Float     @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CFODebt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  balance        Float
  monthlyPayment Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A one-off override of a category's budget for a single calendar month —
// e.g. "no rent this month, put it toward bills instead." Keyed by month,
// so it applies only while that month is being viewed/edited and needs no
// cron or cleanup job to "revert": next month there's simply no override
// row for that key, and the category's normal CFOBudgetCategory.monthlyBudget
// takes over automatically.
model CFOBudgetOverride {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryKey   String // matches CFOBudgetCategory.key
  yearMonth     String // "YYYY-MM"
  monthlyBudget Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, categoryKey, yearMonth])
  @@index([userId, yearMonth])
}

// Protocol CRM's sponsor/venue pipeline (formerly its own ProtocolLead
// model + separate "People" CRM) now lives entirely on Contact above —
// see the ContactType/LeadStatus/LeadPriority enums and the `type` field.

// --- Mass campaigns: bulk email & SMS blasts ("build my own Brevo") -----
//
// Targeting is ad hoc against the live Contact table (type/status/search),
// not a saved segment — there's no separate "list" model. A campaign
// snapshots its matching contacts into *Send rows the moment it's sent, so
// the record of who actually got it doesn't drift if the CRM changes
// later. Sends are drained a batch at a time on the same 15-minute tick as
// Automations/Sequences (see instrumentation.ts) to stay under Amazon
// SES's/Twilio's sending-rate limits, especially while a new SES account
// is still in its sandbox/ramp-up period.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

enum SendStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  COMPLAINED
}

model EmailCampaign {
  id      String         @id @default(cuid())
  name    String
  subject String
  body    String // HTML/plain body — supports {{contactName}}, {{companyName}} merge fields; an unsubscribe link is appended automatically at send time. Ignored (kept only as a fallback/plain-text source) when `blocks` is set.
  status  CampaignStatus @default(DRAFT)

  // Visual block editor: an ordered array of EmailBlock objects (image,
  // heading, text, button-with-link, divider, spacer — see
  // src/lib/email-blocks.ts) plus page-level EmailSettings (background
  // color, container color, max width). When set, this — not `body` — is
  // what gets rendered and sent.
  blocks   Json?
  settings Json?

  // Ad hoc audience filter, matching the same shape as the CRM's own
  // filters: { types?: ContactType[], statuses?: LeadStatus[], search?: string }
  audienceFilter Json?

  scheduledAt DateTime?
  sentAt      DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sends EmailSend[]

  @@index([status, scheduledAt])
}

model EmailSend {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     EmailCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  listMemberId String?
  listMember   ProtocolListMember? @relation(fields: [listMemberId], references: [id], onDelete: SetNull)
  toEmail      String // snapshot — survives the contact being edited/deleted later
  toName       String?
  status       SendStatus          @default(PENDING)
  externalId   String? // SES message id
  error        String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  // Open/click tracking — set by the tracking pixel and link-redirect
  // routes (src/app/api/track/*) the first time the recipient's email
  // client hits them. openedAt is also set on the first click, since a
  // click implies an open even if the pixel itself was blocked.
  openedAt       DateTime?
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  clickCount     Int       @default(0)

  @@unique([campaignId, contactId])
  @@unique([campaignId, listMemberId])
  @@index([campaignId, status])
  @@index([toEmail])
}

// One row per email address that must never receive a campaign again —
// they clicked "unsubscribe", or SES reported a bounce/complaint for them
// via the SNS webhook (see /api/webhooks/ses).
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // UNSUBSCRIBE | BOUNCE | COMPLAINT
  createdAt DateTime @default(now())
}

model SmsCampaign {
  id     String         @id @default(cuid())
  name   String
  body   String // supports {{contactName}}, {{companyName}} merge fields; "Reply STOP to unsubscribe" is appended automatically
  status CampaignStatus @default(DRAFT)

  audienceFilter Json?

  scheduledAt DateTime?
  sentAt      DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sends SmsSend[]

  @@index([status, scheduledAt])
}

model SmsSend {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     SmsCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  listMemberId String?
  listMember   ProtocolListMember? @relation(fields: [listMemberId], references: [id], onDelete: SetNull)
  toPhone      String
  toName       String?
  status       SendStatus          @default(PENDING)
  externalId   String? // Twilio message sid
  error        String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  @@unique([campaignId, contactId])
  @@unique([campaignId, listMemberId])
  @@index([campaignId, status])
  @@index([toPhone])
}

// Phone numbers that texted STOP/UNSUBSCRIBE/CANCEL (see the sms-inbound
// webhook) — checked before every future SMS campaign send.
model SmsSuppression {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String // UNSUBSCRIBE
  createdAt DateTime @default(now())
}

// --- Protocol List: the audience for the free-workout/events crowd ------
//
// Completely separate from the Protocol CRM (sponsors/venues/clients) —
// this is the "everyone who's ever come to a Protocol event or signed up"
// list, the same audience Brevo's signup-form list used to hold. For now
// entries are added by hand (one at a time or pasted in bulk); `source`
// is here so a future public signup form can add rows the same way
// without a schema change. A person needs at least an email or a phone
// (not necessarily both) to be useful to a campaign — enforced in the API,
// not the DB, so a name-only entry can still be added and filled in later.
enum ListSource {
  MANUAL
  FORM
}

model ProtocolListMember {
  id     String     @id @default(cuid())
  name   String?
  email  String?
  phone  String?
  source ListSource @default(MANUAL)
  notes  String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  emailSends EmailSend[]
  smsSends   SmsSend[]

  @@index([email])
  @@index([phone])
}

// --- Content Performance: does what you post sell tickets? --------------
//
// Answers "what kind of content sells my events": every Reel pulled from
// Instagram (media + insights, auto-synced) gets transcribed and
// AI-categorized, then linked to whichever event(s) it was promoting.
// Ticket/RSVP numbers come in per event — Zeffy auto-syncs via its API
// (see lib/integrations/zeffy.ts), Partiful is entered by hand since it
// has no public API, only a manual guest-list export. The Performance tab
// then reads posts + events together to say which content style actually
// correlates with sales, not just which got the most views.

enum EventPricing {
  PAID
  FREE
}

enum TicketingPlatform {
  ZEFFY
  PARTIFUL
}

model MarketingEvent {
  id        String            @id @default(cuid())
  name      String
  eventDate DateTime
  pricing   EventPricing
  platform  TicketingPlatform

  // Zeffy side (auto-synced — see lib/integrations/zeffy.ts /
  // syncZeffySales in lib/content-performance.ts). zeffyCampaignId links
  // this event to one of your Zeffy campaigns; tickets/revenue are kept
  // as a mirror of Zeffy's numbers, refreshed on every sync, not the
  // source of truth themselves.
  zeffyCampaignId String?
  ticketsSold     Int?
  revenue         Float?

  // Partiful side — no API, so this is typed in by hand from the guest
  // list Partiful lets you export.
  rsvpCount Int?

  notes String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts InstagramPost[]

  @@index([eventDate])
}

enum TranscriptStatus {
  PENDING // just synced, not processed yet
  PROCESSING
  DONE
  FAILED
  SKIPPED // not a video (image/carousel of stills) — nothing to transcribe
}

// One row per Reel/post pulled from your connected Instagram account.
// Populated by syncInstagramContent() in lib/content-performance.ts;
// views/likes/comments/shares are refreshed for recent posts on every
// sync since engagement keeps climbing for a while after posting.
model InstagramPost {
  id        String  @id @default(cuid())
  igMediaId String  @unique
  permalink String?
  mediaType String? // VIDEO | REELS | CAROUSEL_ALBUM | IMAGE, as reported by the Graph API
  caption   String?

  transcript       String?
  transcriptStatus TranscriptStatus @default(PENDING)
  transcriptError  String?

  // AI read of the transcript+caption — a short label (e.g.
  // "documentation/behind-the-scenes", "hype/promo", "educational",
  // "testimonial", "event recap") plus a sentence on why, set by
  // categorizePendingPosts() in lib/content-performance.ts.
  contentCategory   String?
  categoryReasoning String?

  thumbnailUrl String?
  postedAt     DateTime?

  views    Int?
  likes    Int?
  comments Int?
  shares   Int?
  saves    Int?

  lastMetricsSyncAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Which connected account this media belongs to — nullable only for
  // rows synced before multi-account support existed; every row synced
  // going forward gets one. See connectInstagramManually() / the
  // Settings "Instagram" card for how accounts are added.
  instagramConnectionId String?
  instagramConnection    InstagramConnection? @relation(fields: [instagramConnectionId], references: [id], onDelete: SetNull)

  events       MarketingEvent[]
  contentPosts ContentPost[]
  carousels    ContentCarousel[]

  @@index([postedAt])
  @@index([transcriptStatus])
  @@index([instagramConnectionId])
}

// Long-lived Instagram access token for the one connected professional
// account (Business Login for Instagram — Standard Access, since this
// only ever reads your own account, no Meta App Review needed). Tokens
// last ~60 days and must be refreshed before they expire; see
// refreshInstagramTokenIfNeeded() in lib/integrations/instagram.ts.
model InstagramConnection {
  id             String    @id @default(cuid())
  igUserId       String    @unique
  username       String?
  // Optional nickname so multiple connected accounts are easy to tell
  // apart in Settings and the Content Engine's account picker (e.g.
  // "Protocol brand" vs "Vlad personal") — purely cosmetic, never sent
  // to Meta.
  label          String?
  accessToken    String // encrypted at rest, see src/lib/crypto.ts
  tokenExpiresAt DateTime
  lastRefreshAt  DateTime?
  connectedAt    DateTime  @default(now())

  posts        InstagramPost[]
  contentPosts ContentPost[]
}

// Zeffy has no OAuth flow — just a bearer API key generated from their
// dashboard (Settings → Integrations). One key for the whole account,
// same pattern as TwilioConnection.
model ZeffyConnection {
  id          String   @id @default(cuid())
  apiKey      String // encrypted at rest
  connectedAt DateTime @default(now())
}

// --- Content Engine: idea queue -> AI-drafted scripts -> production
// status -> calendar/publish -> pre-post scoring -> repurposing into
// carousels. Builds on the existing Instagram sync (InstagramPost /
// InstagramConnection) instead of a second integration — ContentPost
// links out to the InstagramPost row once a post is actually published
// and the regular sync pulls it back in, so Analyze reads real numbers
// rather than a second metrics table. Nothing here copies any
// third-party scoring algorithm, UI, or branding — original
// implementation of the same functional idea.

enum ContentIdeaStatus {
  INBOX // saved, not yet turned into a script
  SCRIPTED // at least one script has been drafted from it
  ARCHIVED
}

// Swipe stage: a saved reference post (yours or a competitor's) kept as
// inspiration, with a note on why it worked. hookPattern is a short
// AI-set tag (e.g. "names the enemy", "hook in first second") from
// tagContentIdea() in lib/content-engine.ts — optional, never required
// to save an idea.
model ContentIdea {
  id             String            @id @default(cuid())
  title          String
  sourceUrl      String?
  sourcePlatform String            @default("instagram")
  whyItWorks     String? // the user's own note on why this is worth swiping
  hookPattern    String? // AI-tagged angle, set on save if Claude is configured
  status         ContentIdeaStatus @default(INBOX)

  scripts ContentScript[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

enum ContentScriptStatus {
  DRAFT // AI-drafted or hand-written, not yet approved
  APPROVED // locked in, ready to film
  FILMING
  EDITING
  READY // edited, ready to schedule/post
  POSTED
  ARCHIVED
}

// Script stage: a titled script broken into hook/body/closing prompt,
// either drafted by Claude from a ContentIdea (draftContentScript() in
// lib/content-engine.ts) or written by hand. viralityScore is a pre-post
// prediction (0-100, our own original scoring — see
// scoreContentScript()). productionFormat/status track the shoot/edit
// pipeline manually for now — no AI video generation is wired in until
// there's a HeyGen-style provider account.
model ContentScript {
  id            String  @id @default(cuid())
  title         String
  hook          String
  body          String // multi-line beats, one idea per line
  closingPrompt String? // the comment-bait line the script ends on

  status           ContentScriptStatus @default(DRAFT)
  productionFormat String? // e.g. "Talking head", "Voiceover + b-roll", "Text overlay" — free text, manual for now

  viralityScore Int? // 0-100, pre-post prediction
  viralityNotes String? // short AI explanation behind the score

  ideaId String?
  idea   ContentIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  posts ContentPost[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

enum ContentPostStatus {
  SCHEDULED
  PUBLISHED
  FAILED
}

// Post/Calendar stage: when a finished script is meant to go out.
// Publish pushes to Instagram via publishInstagramReel() in
// lib/integrations/instagram.ts once scheduledFor arrives;
// instagramPostId links it to the InstagramPost row the regular sync
// pulls back in afterward.
model ContentPost {
  id           String            @id @default(cuid())
  caption      String?
  // A publicly reachable URL for the finished, edited video (e.g.
  // uploaded to S3/Cloudinary/etc. outside this app) — required to
  // actually publish, since Instagram's Content Publishing API needs a
  // hosted file to fetch, not a local upload. Left null, this row is
  // just a calendar placeholder until a video exists.
  videoUrl     String?
  scheduledFor DateTime?
  status       ContentPostStatus @default(SCHEDULED)
  publishError String?

  scriptId String?
  script   ContentScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  instagramPostId String?        @unique
  instagramPost   InstagramPost? @relation(fields: [instagramPostId], references: [id], onDelete: SetNull)

  // Which connected account to publish this post to — required (set in
  // the Calendar UI) before Publish will work when more than one
  // account is connected.
  instagramConnectionId String?
  instagramConnection    InstagramConnection? @relation(fields: [instagramConnectionId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scheduledFor])
  @@index([status])
  @@index([instagramConnectionId])
}

enum ContentCarouselStatus {
  DRAFT
  READY
  POSTED
}

// Repurpose stage: takes one winning InstagramPost and spins it into new
// hook angles plus a slide-by-slide carousel breakdown. Generated by
// repurposeWinningPost() in lib/content-engine.ts — original
// implementation of the functional idea, not a copy of any third-party
// algorithm or UI.
model ContentCarousel {
  id       String                @id @default(cuid())
  title    String
  newHooks String[]              @default([])
  status   ContentCarouselStatus @default(DRAFT)

  sourcePostId String?
  sourcePost   InstagramPost? @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)

  slides ContentCarouselSlide[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentCarouselSlide {
  id         String          @id @default(cuid())
  carouselId String
  carousel   ContentCarousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  position   Int
  text       String

  @@index([carouselId])
}

// Images uploaded through the campaign email block editor. Stored as raw
// bytes in the database rather than on disk/S3, since Railway's app
// containers don't have persistent storage across deploys — this way an
// uploaded image survives redeploys with zero extra infra. Served back
// out at /api/uploads/[id] with a long cache lifetime, and that URL is
// what actually goes into the sent email's <img src>.
model UploadedImage {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  filename    String?
  size        Int
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// Audio captured live in the browser (MediaRecorder, phone on speaker)
// via the "Record live call" option on a lead's timeline — for when
// Vlad is on a call from his own phone's native dialer, not dialed
// through Twilio, and just wants the conversation recorded. Bytes live
// here (same pattern as UploadedImage); the Interaction row it's
// attached to points its recordingUrl at /api/call-recordings/[id]/audio,
// which lib/call-transcription.ts recognizes and reads directly from
// this table rather than fetching over HTTP (no network call, no auth
// headers to figure out, unlike a Twilio or Zoom recording URL).
model CallRecording {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  size        Int
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// --- Brand Activations: the B2B event-ops pipeline -----------------------
//
// Built from the Protocol B2B SOP manual (v1.3). A Contact becomes an
// Activation once a brand deal is actually signed (status WON) — this is
// deliberately a separate 1:1 record rather than more Contact fields,
// since the SOP's timeline/rules/cost-sheet/sponsor data only exists for
// signed deals, not for every lead in the pipeline above it.

enum ActivationPackageTier {
  BRONZE
  SILVER
  GOLD
}

// The SOP's 17-step timeline (Section 00/03), one row per step, seeded
// when an Activation is created and dated backward from eventDate. owner
// is freeform ("V" | "M" | "V+M" | "Brand") to match the SOP's table
// exactly rather than forcing every step into a single-person enum.
model ActivationStep {
  id           String     @id @default(cuid())
  activationId String
  activation   Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  stepNumber   Int // 1-18, Activation Playbook phase order (A-E)
  phase        String     @default("") // "A".."E", see activation-timeline.ts PHASE_LABELS
  title        String
  owner        String
  dueDate      DateTime?
  doneWhen     String // the playbook's "done when" column, shown as a hint
  done         Boolean    @default(false)
  doneAt       DateTime?

  @@unique([activationId, stepNumber])
  @@index([activationId])
}

// Secondary sponsor slots per event (SOP Section 05). One sponsor per
// category, and the main client's own category is automatically
// exclusive — enforced in src/lib/activation-sponsors.ts, not just in
// the UI, so a second brand in a filled category can't be saved at all.
model SponsorSlot {
  id           String     @id @default(cuid())
  activationId String
  activation   Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  category     String // e.g. "Coffee", "Skincare", "Massage / bodywork"
  brandName    String?
  tier         String? // Sampling Only | Booth Sponsor | Experience Sponsor | Co-Presenting
  fee          Float?
  confirmed    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([activationId])
}

// The 20/40/40 payment schedule (SOP Section 02/06), generated from the
// cost sheet total. Each milestone optionally links to a CFOTransaction
// once it's actually invoiced/received, so Protocol's committed revenue
// shows up in the existing CFO module instead of living only here.
model ActivationPayment {
  id               String          @id @default(cuid())
  activationId     String
  activation       Activation      @relation(fields: [activationId], references: [id], onDelete: Cascade)
  label            String // "Deposit (20%)" | "Second payment (40%, T-7 days)" | "Final payment (40%)"
  amount           Float
  dueDate          DateTime?
  status           String          @default("PLANNED") // PLANNED | INVOICED | RECEIVED
  cfoTransactionId String?         @unique
  cfoTransaction   CFOTransaction? @relation(fields: [cfoTransactionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([activationId])
}

model Activation {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  eventName String
  eventDate DateTime?

  packageTier      ActivationPackageTier @default(BRONZE)
  clientMultiplier Float                 @default(5) // 5-10x, see SOP Section 02

  // Activation Rules gate (SOP Section R). Gate 1 (rules 1-4) is required
  // before the proposal goes out (step 3); gate 2 (rules 5-10) is required
  // before the team brief (step 7). Stored as free text, one field per
  // rule, since each rule's "pass" condition is a written sentence, not a
  // boolean — see src/lib/activation-rules.ts for the gate check itself.
  rule1Goal          String?
  rule2Connection    String?
  rule3Currency      String?
  rule4Story         String?
  gate1PassedAt      DateTime?
  rule5StartEarly    String?
  rule6GrandEntrance String?
  rule7Journey       String?
  rule8PeakMoment    String?
  rule9Trigger       String?
  rule10CloseLoop    String?
  gate2PassedAt      DateTime?

  // Cost sheet (SOP Section 01/02). lineItems mirrors the SOP artifact's
  // fill-in calculator: [{ group, label, qty, unitCost }]. Totals are
  // recomputed server-side from lineItems on every save, not trusted from
  // the client — see src/lib/activation-cost-sheet.ts.
  costLineItems    Json  @default("[]")
  costBaseA        Float @default(0) // multiplied cost base incl. 10% contingency
  costPassThroughB Float @default(0) // venue/permits, billed at cost
  quotePreTax      Float @default(0)
  quoteTax         Float @default(0) // GST 5% + QST 9.975%
  quoteTotal       Float @default(0)

  // Category exclusivity anchor for the sponsor tracker (SOP Section 05) —
  // defaults to the main Contact's industry but editable, since "Pilates
  // studio" (industry) and "yoga/fitness" (sponsor-exclusivity category)
  // don't always read as the same string.
  mainSponsorCategory String?

  // AI-drafted documents (reuses the same Claude Haiku call already used
  // for cold-outreach research — see src/lib/activation-drafts.ts). Each
  // is a draft only: nothing sends on its own, same as SequenceStepDraft.
  proposalDraft String?
  contractDraft String?
  reportDraft   String?

  // Post-event report scorecard (Playbook "Measurement and the recap
  // report" — attendanceActual doubles as check-ins for the show-up-rate
  // formula; quoteTotal is the brand fee used in cost-per-lead/trial).
  attendanceTarget   Int?
  attendanceActual   Int?
  rsvpCount          Int? // for show-up rate = attendanceActual / rsvpCount
  productsTriedCount Int? // for trial rate = productsTriedCount / attendanceActual
  optInCount         Int? // consented opt-ins, for opt-in rate & cost per lead
  dayOfConversions   Int?
  revenueReported    Float?
  totalImpressions   Int?
  contentCpm         Float? // brand-agreed CPM, for content value = impressions/1000 x cpm
  referralCount      Int?
  npsScore           Int? // % rating 9-10 minus % rating 0-6
  offerCode          String? // this event's unique offer code, for provable redemptions
  reportNextStep     String?

  // Content asset checklist (Playbook "Content and shareability engine")
  // — [{ key, label, who, deliveredWithin, done, link }], seeded from
  // CONTENT_ASSET_TEMPLATE at creation — see activation-content-assets.ts.
  contentAssets Json @default("[]")

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps     ActivationStep[]
  sponsors  SponsorSlot[]
  payments  ActivationPayment[]
  documents SopDocument[]
}

// A client-facing document built from one of the SOP's 7 templates
// (proposal, contract, attendee form, run-of-show/shot list, roster,
// survey, post-event report). fields/rows hold the filled-in values —
// the template's own field/row-group definitions live in
// src/lib/sop-templates.ts so content stays in one place. Each save is
// a full document (not versioned); exporting to PDF happens client-side
// from the same rendered markup used for the live preview.
model SopDocument {
  id           String     @id @default(cuid())
  activationId String
  activation   Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  type SopDocType
  name String

  fields Json @default("{}")
  rows   Json @default("{}")

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([activationId])
}

enum SopDocType {
  PROPOSAL
  CONTRACT
  ATTENDEE
  RUNOFSHOW
  ROSTER
  SURVEY
  REPORT
}

// --- Sales (call-tracking dashboard) --------------------------------------

// Quick-access reference material for the Sales dashboard — cold-call
// script, demo/discovery-call script, objection responses, etc. Simple
// and admin-editable for now (no version history yet); every rep can
// read, only the owner edits (see api/sales/scripts).
model SalesScript {
  id        String   @id @default(cuid())
  title     String
  category  String // e.g. "Cold call", "Demo call", "Objections", "Follow-up"
  body      String
  sortOrder Int      @default(0)
  updatedById String?
  updatedBy   User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}
